# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is already covered by .gitignore).

# --- Source: ロリポップ！レンタルサーバー (IMAP) ---
# ロリポップ管理画面 > メール > メールソフト設定 で確認できます。
LOLIPOP_IMAP_HOST=imap.lolipop.jp
LOLIPOP_IMAP_PORT=993
LOLIPOP_IMAP_SECURE=true
# 移行したいメールアドレスそのもの（例: info@beautifulsnow.co.jp）
LOLIPOP_IMAP_USER=info@beautifulsnow.co.jp
LOLIPOP_IMAP_PASSWORD=

# カンマ区切りで取り込むIMAPフォルダ名を指定（未設定なら INBOX のみ）
# 例: INBOX,Sent
LOLIPOP_IMAP_FOLDERS=INBOX

# 差分同期をしたい場合のみ設定（このISO日時以降に受信したメールだけ取得）
# 例: 2026-08-01T00:00:00Z
LOLIPOP_IMAP_SINCE=

# --- Destination: email-explorer-ja (Cloudflare Worker) ---
# workers.dev の既定URL、または独自ドメインを設定した場合はそのURL
TARGET_API_BASE_URL=https://email-explorer-ja.YOUR-SUBDOMAIN.workers.dev

# インポート先のメールボックスID（= メールアドレスそのもの）
TARGET_MAILBOX_ID=info@beautifulsnow.co.jp

# email-explorer-ja 側の管理者アカウント（このスクリプト専用に作成推奨）
TARGET_ADMIN_EMAIL=admin@example.com
TARGET_ADMIN_PASSWORD=

# --- Options ---
# true にすると実際には送信せず、件数だけ表示します（動作確認用）
DRY_RUN=true
