/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2025-11-28",
	"main": "index.ts",
	"name": "email-explorer-ja",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"compatibility_flags": ["nodejs_compat", "enable_email_sending_queuing"],
	// Once a day, 18:00 UTC (03:00 JST). The Worker wakes, and each mailbox's
	// own frequency decides whether it is backed up this time -- so this only
	// has to fire as often as the shortest frequency on offer, which is daily.
	"triggers": {
		"crons": ["0 18 * * *"]
	},
	// These three are this deployment's own. A fork sets its values as GitHub
	// repository variables instead of editing them here, so pulling updates
	// from upstream never collides -- see scripts/deployment-config.mjs and
	// docs/deploying-your-own.md. What is written here is the default, and it
	// is also what `wrangler dev` and the test pool read.
	"vars": {
		"VAPID_PUBLIC_KEY": "BGU5ROPsWyFfKmU6wSP0Zff_Ilp1k6DLi-AgwA45rUgFYPqDy-BGTDuSOysCtpteFr0IqwaRMvjP5AJGy_P0g5U",
		// Blank here because this deployment sets its own in dev/index.ts.
		// Whatever is set here wins over that, which is what lets a fork
		// configure the sender without touching source. See
		// src/deployment-config.ts.
		"ACCOUNT_RECOVERY_FROM": ""
	},
	"assets": {
		"directory": "node_modules/email-explorer/dashboard",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/docs", "/openapi.json"]
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "email-explorer-ja",
			"preview_bucket_name": "email-explorer-ja",
//			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MailboxDO"]
		}
	]
}
