{
	"name": "email-explorer",
	"version": "1.1.0",
	"description": "A self-hosted, serverless worker for sending and receiving emails on Cloudflare",
	"scripts": {
		"build": "rm -rf dashboard && cp -R ../dashboard/dist dashboard",
		"test": "tsc && tsc -p tests/tsconfig.json && tsc -p tests/tsconfig.node.json && npx vitest run --config tests/vitest.config.mts"
	},
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"keywords": [
		"cloudflare",
		"worker",
		"workers",
		"serverless",
		"cloudflare email routing",
		"cloudflare email sending",
		"gmail",
		"ui",
		"cf",
		"typescript",
		"npm",
		"package",
		"esm",
		"umd",
		"typed"
	],
	"author": "Gabriel Massadas",
	"license": "MIT",
	"homepage": "https://github.com/G4brym/email-explorer",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/G4brym/email-explorer.git"
	},
	"bugs": {
		"url": "https://github.com/G4brym/email-explorer/issues"
	},
	"dependencies": {
		"@pushforge/builder": "^2.0.5",
		"chanfana": "3.4.0",
		"hono": "4.13.10",
		"postal-mime": "^4.0.0",
		"workers-qb": "^1.15.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260929.1",
		"@types/node": "24.10.1",
		"typescript": "5.9.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.143.0"
	}
}
