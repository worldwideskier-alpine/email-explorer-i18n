# Security headers for the dashboard's static assets. Cloudflare Workers
# Assets reads this file the way Pages does; the Worker itself never serves
# index.html (run_worker_first only routes /api/*, /docs and /openapi.json to
# it), so this is the only place a header can be attached to the page.
/*
  # script-src 'self' is the one that matters: no inline script, no eval, and
  # nothing from another origin can run, which is what an injected payload
  # would need.
  #
  # 'unsafe-inline' is unavoidable for styles. The email body is rendered in
  # an iframe built with srcdoc, and a srcdoc frame inherits this policy --
  # real mail is full of inline style attributes, and blocking them would
  # leave every message looking broken. With scripts blocked, an inline style
  # is not a way in.
  #
  # img-src is wide open for the same reason: mail loads images from
  # wherever the sender put them. That is a privacy cost (a tracking pixel
  # tells the sender the message was opened), not a way to run code.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; media-src 'self' data: blob: https:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  # Belt and braces with frame-ancestors, for anything that predates CSP.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  # Referrers are for our own origin only: a path here can name a mailbox.
  Referrer-Policy: same-origin
  # None of these are used, and saying so stops a compromised page from
  # asking for them.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# The page names the build, and the build is what a fix arrives in, so the
# page is the one file that must never be answered from a cache without
# asking. Its name never changes while its contents do, which is the opposite
# of everything under /assets/, where the name carries a hash of the contents.
#
# Stated rather than fixed: measured against the local runtime, the assets
# handler already answers the page with `public, max-age=0, must-revalidate`,
# which has the same effect. This says so on purpose instead of relying on a
# default nobody chose, and the deploy checks it (staleServedPage in
# packages/worker/scripts/deployment-check.mjs) so that a later `max-age` on
# the page is caught at the deploy rather than found on a phone.
#
# `no-cache` is not "do not store" -- the copy is kept and revalidated, so an
# unchanged page costs a 304 rather than a download.
#
# And note what this does *not* fix, since it was the actual fault: a page on
# somebody's home screen is resumed rather than loaded, so it asks for nothing
# at all, whatever this file says. See src/services/appUpdate.ts.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
