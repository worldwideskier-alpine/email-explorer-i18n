{
	"name": "email-explorer-root",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"lint": "npx @biomejs/biome check packages/dashboard/src packages/worker/src packages/worker/scripts packages/worker/tests || (npx @biomejs/biome check --write packages/dashboard/src packages/worker/src/ packages/worker/scripts packages/worker/tests; exit 1)",
		"build-dashboard": "pnpm run --filter email-explorer-dashboard build",
		"build-worker": "pnpm run --filter email-explorer build",
		"test-worker": "pnpm run --filter email-explorer test",
		"test-dashboard": "pnpm run --filter email-explorer-dashboard test",
		"test": "pnpm test-worker && pnpm test-dashboard",
		"build": "pnpm build-dashboard && pnpm build-worker",
		"deploy-dev-worker": "pnpm run --filter email-explorer-dev-worker deploy"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"wrangler": "^4.127.1"
	}
}
